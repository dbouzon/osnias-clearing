# Common
MTLS_CERT=/etc/osnias/certs/oracle.crt
MTLS_KEY=/etc/osnias/certs/oracle.key
MTLS_CA=/etc/osnias/certs/osnias-ca.crt
ORACLE_SIGNING_PRIVATE_KEY=/etc/osnias/keys/oracle-signing.pem
PEER_SIGNING_PUBLIC_KEY=/etc/osnias/keys/peer-signing.pub

# Sei service
SEI_RPC_URL=https://evm-rpc-testnet.sei-apis.com
SEI_ORACLE_TX_PRIVATE_KEY=DO_NOT_COMMIT
BURN_SEI_ADDRESS=0x...
EVM_ORACLE_URL=https://evm-oracle.internal.example:9444
PORT=9443

# EVM service
EVM_RPC_URL=https://...
EVM_ORACLE_TX_PRIVATE_KEY=DO_NOT_COMMIT
BURN_EVM_ADDRESS=0x...
SEI_ORACLE_URL=https://sei-oracle.internal.example:9443
PORT=9444
