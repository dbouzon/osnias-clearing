# Osnias AI Coordinator — configuration d'exemple (T02, sans secrets)
# Copier vers .env et adapter. Aucune valeur secrète ne doit être versionnée.

# Écoute locale uniquement en T02 (prototype local, pas de cloud).
AIC_LISTEN_ADDR=127.0.0.1:8080

# Secret de vérification HMAC des webhooks GitHub (à générer : openssl rand -hex 32).
# À fournir par l'environnement du serveur, jamais dans le dépôt.
AIC_WEBHOOK_SECRET=

# Identité du compte bot qui publie les commentaires (anti-boucle).
AIC_COORDINATOR_LOGIN=osnias-aic-bot

# Identités habilitées à émettre les commandes /aic (start, correction, approve,
# block), séparées par des virgules. Politique fail closed : si la liste est
# vide, AUCUNE commande n'est acceptée. L'habilitation est vérifiée sur le
# sender authentifié GitHub, indépendamment de la signature HMAC du webhook.
AIC_AUTHORIZED_LOGINS=dbouzon

# Dépôt GitHub surveillé.
AIC_GITHUB_REPO=dbouzon/osnias-clearing

# Adaptateurs : mode simulé par défaut (aucun appel API payant).
AIC_MISTRAL_MODE=simulated
AIC_OPENAI_MODE=simulated

# Adaptateur OpenAI réel (M-AIC-04). AIC_OPENAI_MODE=api exige une clé ;
# sans clé, le coordinateur et aic-openai-ping refusent de démarrer (fail
# closed). La clé reste en mémoire : jamais dans le dépôt, jamais journalisée.
# AIC_OPENAI_MODE=api
# AIC_OPENAI_APIKEY= (clé de test dédiée, environnement uniquement)
# AIC_OPENAI_APIURL=https://api.openai.com/v1
# AIC_OPENAI_MODEL=gpt-4o-mini
# AIC_OPENAI_TIMEOUT=60s
# AIC_OPENAI_MAX_TOKENS=400

# Bornes d'exécution de l'agent développeur.
AIC_MISTRAL_TIMEOUT=600
AIC_MISTRAL_MAX_ITER=40
AIC_MISTRAL_BUDGET_STEPS=50

# Plafond de corrections par mission (au-delà : BLOCKED).
AIC_MAX_CORRECTIONS=3

# Persistance.
AIC_DB_PATH=/var/lib/aic/ai-coordinator.sqlite
AIC_WORK_ROOT=/var/lib/aic/work
AIC_RUN_STALE_INTERVAL=86400

# Relance périodique de la file d'événements en attente pendant le
# fonctionnement normal (T02-R3, risque 1).
AIC_PENDING_RETRY_INTERVAL=60
