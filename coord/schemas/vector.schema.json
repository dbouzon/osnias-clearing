{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.osnias-clearing.com/coord/schemas/vector.schema.json",
  "version": "1.0",
  "title": "COORD conformance vector collection (coord-conformite-v1, spec 10)",
  "type": "object",
  "required": ["format", "fichier", "description", "vecteurs"],
  "properties": {
    "format": { "const": "coord-conformite-v1" },
    "fichier": { "type": "string" },
    "description": { "type": "string" },
    "vecteurs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nom", "operations", "attendu"],
        "properties": {
          "nom": { "type": "string", "minLength": 1 },
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["operation"],
              "properties": {
                "operation": { "enum": ["mission", "transition", "valider_habilitations", "arbitrer"] }
              }
            }
          },
          "attendu": { "type": "object" }
        }
      }
    }
  },
  "additionalProperties": true
}
